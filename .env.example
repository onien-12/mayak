# Settings for `docker compose up`. Copy to `.env` (git-ignored) and fill in.
# For local development without Docker use backend/.env and frontend/.env instead.

# Signing key for access tokens and captcha (32+ random characters).
SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars

# 2GIS key (https://dev.2gis.com/): MapGL, Suggest, Places, Geocoder, Static.
# Baked into the web build and used by the backend for place ratings. Route lines are built on
# OpenStreetMap data (FOSSGIS OSRM, no key).
TWOGIS_API_KEY=

# OpenRouter key for LLM pre-screening of user content. Empty = heuristics only.
OPENROUTER_API_KEY=

# Interest topics for «Для вас» from an LLM (needs OPENROUTER_API_KEY). Empty = on with a key.
INTERESTS_LLM_ENABLED=
INTERESTS_LLM_MODEL=typesafe/jev-router
INTERESTS_LLM_DAILY_REQUEST_CAP=2000

# Host port of the web container.
WEB_PORT=8080

# Background imports from VL.ru and the external-reviews experiment.
AFISHA_IMPORT_ENABLED=true
OUTAGES_IMPORT_ENABLED=true
EXTERNAL_REVIEWS_ENABLED=false
EXTERNAL_REVIEWS_TWOGIS_ENABLED=true
EXTERNAL_REVIEWS_GOOGLE_ENABLED=true
# Optional proxy for external reviews only. {sid} becomes a random session ID.
EXTERNAL_REVIEWS_PROXY_URL=
EXTERNAL_REVIEWS_REQUEST_TIMEOUT_S=20
# Requests per source and rolling day (lookups and «Показать ещё» pages together).
EXTERNAL_REVIEWS_DAILY_REQUEST_CAP=10000
# Identity check by an LLM where the matching rules abstain (needs OPENROUTER_API_KEY). Empty = on with a key.
EXTERNAL_REVIEWS_LLM_MODEL=typesafe/jev-router
EXTERNAL_REVIEWS_LLM_ENABLED=
