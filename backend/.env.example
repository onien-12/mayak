# Маяк — backend settings. Copy to `.env` and fill in the secrets. Never commit `.env`.

# Signing key for JWT access tokens and captcha tokens (at least 32 characters).
SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars

# SQLAlchemy async URL. Default: SQLite file in backend/data/mayak.db.
# DATABASE_URL=sqlite+aiosqlite:///./data/mayak.db

# Directory for uploaded photos, served at /media. Default: backend/media.
# MEDIA_DIR=./media

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:5173

# 2GIS key: aggregate ratings (Places API) and, optionally, the `2gis` routing provider.
TWOGIS_API_KEY=

# Route lines along roads and trails: providers tried in order, comma-separated.
# `osrm` = OpenStreetMap data via the public FOSSGIS OSRM server (no key, <= 1 request/s);
# `2gis` = 2GIS Routing API (needs a key with Routing). None answering = straight segments.
# After switching providers run `uv run python -m app.routes_recompute`.
ROUTING_PROVIDERS=osrm
OSRM_BASE_URL=https://routing.openstreetmap.de

# Seed demo data when the database is empty (first start).
SEED_ON_STARTUP=true

# Background imports from VL.ru (SPEC §11, §15): afisha every 12 h, outages every 20 min.
AFISHA_IMPORT_ENABLED=true
OUTAGES_IMPORT_ENABLED=true

# Screening through OpenRouter before others see a publication (SPEC §14, §24). No key = released at once.
OPENROUTER_API_KEY=
LLM_MODERATION_MODEL=deepseek/deepseek-v4.1-flash
# Leave unset to enable automatically when a key is present; set to false to force off.
# LLM_MODERATION_ENABLED=true
LLM_MODERATION_IMAGES=true
LLM_MODERATION_DAILY_LIMIT=2000

# Interest topics for «Для вас» (SPEC §23) from an LLM through OpenRouter (OPENROUTER_API_KEY).
# Leave unset to enable automatically with a key; false = the rules alone (category, kind, keywords).
# Re-tag by hand: `uv run python -m app.services.interests.classify [--limit N] [--rules-only]`.
# INTERESTS_LLM_ENABLED=true
INTERESTS_LLM_MODEL=typesafe/jev-router
INTERESTS_LLM_DAILY_REQUEST_CAP=2000

# OpenStreetMap base layer (SPEC §18): bounding box south,west,north,east for
# `python -m app.osm_import --fetch`. The app itself only reads the committed snapshot.
OSM_BBOX=42.95,131.80,43.25,132.05

# 2GIS aggregate ratings on place / area cards (SPEC §19): requests per rolling day.
TWOGIS_RATING_DAILY_LIMIT=30

# Yandex, 2GIS and Google reviews next to our own (SPEC §20) and the blended rating (SPEC §22).
# Off unless explicitly enabled.
# Warm-up for a demo database: `uv run python -m app.services.experimental.external_reviews.warmup`.
EXTERNAL_REVIEWS_ENABLED=false
EXTERNAL_REVIEWS_TWOGIS_ENABLED=true
EXTERNAL_REVIEWS_GOOGLE_ENABLED=true
# Optional proxy for this experiment only; HTTP(S), SOCKS5 or SOCKS5H. Keep credentials out of git.
# A literal {sid} in the URL is replaced with a random session ID per client instance.
EXTERNAL_REVIEWS_PROXY_URL=
EXTERNAL_REVIEWS_REQUEST_TIMEOUT_S=20
# Requests per source and rolling day, lookups and «Показать ещё» pages together.
EXTERNAL_REVIEWS_DAILY_REQUEST_CAP=10000
# Where the matching rules abstain, an LLM through OpenRouter (OPENROUTER_API_KEY) picks the catalogue
# entry that is our object, or none. Leave unset to enable automatically with a key; false = rules only.
EXTERNAL_REVIEWS_LLM_MODEL=typesafe/jev-router
# EXTERNAL_REVIEWS_LLM_ENABLED=true

# Wikivoyage and Wikimedia (SPEC §19, §21) need no settings: the app reads the committed snapshots,
# `python -m app.wikivoyage_import --fetch` / `python -m app.wikimedia_enrich --fetch` refresh them
# (bounding box: OSM_BBOX; fixed User-Agent without personal data).
